{
  "version": "2",
  "flowTitle": "Daily Quiet Lead Check-ins",
  "trigger": {
    "valid": true,
    "displayName": "Every day at 9:00 AM Chicago time",
    "type": "PIECE_TRIGGER",
    "settings": {
      "pieceName": "@taskade/automade-internalpiece-schedule",
      "pieceVersion": "1.0.0",
      "triggerName": "schedule.daily",
      "input": {
        "timezone": "America/Chicago",
        "timeOfDay": "9:00 AM"
      }
    }
  },
  "actions": [
    {
      "name": "fd8b9561-800f-4589-ab72-da161caf2c30",
      "valid": false,
      "displayName": "Find leads emailed at least three days ago with no reply or prior draft",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-taskade",
        "pieceVersion": "1.0.0",
        "actionName": "tasks.find",
        "input": {
          "ruleset": {
            "type": "or",
            "value": [
              {
                "type": "and",
                "value": [
                  {
                    "id": "4a084d92-f8f0-450f-acf1-96cb354da5e6",
                    "fieldId": "@emlsd",
                    "condition": "date_comes_before",
                    "comparator": "{{ 'now' | date: '%Y-%m-%dT%H:%M:%S%z' | dateOffset: '-P3D' }}"
                  },
                  {
                    "id": "a99b1447-556c-418e-bdf1-20d3b1c7619a",
                    "fieldId": "@resp2",
                    "condition": "text_is_empty",
                    "comparator": ""
                  },
                  {
                    "id": "dcf067f9-05d2-4f51-befd-58dd8cdd22c0",
                    "fieldId": "@fudft",
                    "condition": "text_is_empty",
                    "comparator": ""
                  },
                  {
                    "id": "e481be7d-8a2f-47f5-8968-239e304870eb",
                    "fieldId": "@ce7a8",
                    "condition": "text_is_empty",
                    "comparator": ""
                  },
                  {
                    "id": "177538a4-5807-4424-abd6-5322bd8f3cec",
                    "fieldId": "@eml02",
                    "condition": "text_is_not_empty",
                    "comparator": ""
                  }
                ]
              }
            ]
          },
          "projectId": {
            "type": "flow-template-variable-input-type",
            "id": "wiNSVTzkVhm6kmjK"
          },
          "rowsToReturn": "all_matching_rows",
          "noTasksFoundBehavior": "continue"
        }
      }
    },
    {
      "name": "614eb1d4-5e41-4b4f-b574-b3ed6e0185db-outer",
      "valid": true,
      "displayName": "For each eligible lead",
      "type": "LOOP",
      "settings": {},
      "iteration": {
        "name": "614eb1d4-5e41-4b4f-b574-b3ed6e0185db",
        "valid": true,
        "displayName": "For each eligible lead Iteration",
        "type": "LOOP_ITERATION",
        "loopVariable": {
          "type": "reference",
          "path": [
            "fd8b9561-800f-4589-ab72-da161caf2c30",
            "tasks"
          ]
        },
        "actions": [
          {
            "name": "735b7a8e-6da5-4a2d-b5f6-dd34943993c4",
            "valid": false,
            "displayName": "Draft a friendly check-in with Follow-Up Writer",
            "type": "PIECE",
            "settings": {
              "pieceName": "@taskade/automade-internalpiece-openai",
              "pieceVersion": "1.0.0",
              "actionName": "agent.ask",
              "input": {
                "input": "Draft an approval-only follow-up email for this lead. Lead Records row title: {{ 614eb1d4-5e41-4b4f-b574-b3ed6e0185db-loop[\"currentElement\"][\"nodeText\"] }}. Taskade row ID: {{ 614eb1d4-5e41-4b4f-b574-b3ed6e0185db-loop[\"currentElement\"][\"nodeId\"] }}. The lead was emailed at least three days ago and has not replied. Use the matching lead record in your connected Lead Records knowledge as the source of any name or project context. Do not invent facts. Return a short subject line and a brief, warm plain-text email body, clearly labeled Subject and Body. Do not send the email. If you cannot confidently find this lead in your knowledge, say that a draft could not be prepared rather than guessing.",
                "agentId": {
                  "type": "flow-template-variable-input-type",
                  "id": "01M71KJN8H0SPRYYP4VG6T2YBC"
                }
              }
            }
          },
          {
            "name": "18cc3c9f-262c-422f-bd4f-c2cf78415b59",
            "valid": false,
            "displayName": "Record this follow-up attempt",
            "type": "PIECE",
            "settings": {
              "pieceName": "@taskade/automade-internalpiece-taskade",
              "pieceVersion": "1.0.0",
              "actionName": "updateCustomFields",
              "input": {
                "fields": {
                  "@ce7a8": {
                    "data": {
                      "value": "{{ trigger[\"triggeredAt\"] }}"
                    },
                    "rank": "0",
                    "fieldId": "@ce7a8"
                  }
                },
                "nodeId": "{{ 614eb1d4-5e41-4b4f-b574-b3ed6e0185db-loop[\"currentElement\"][\"nodeId\"] }}",
                "projectId": {
                  "type": "flow-template-variable-input-type",
                  "id": "wiNSVTzkVhm6kmjK"
                }
              }
            }
          },
          {
            "name": "83642169-ec35-480a-8644-b83ca4fe650a",
            "valid": false,
            "displayName": "Review the check-in draft",
            "type": "APPROVAL",
            "settings": {
              "approverUserIds": [],
              "title": "Review check-in draft for {{ 614eb1d4-5e41-4b4f-b574-b3ed6e0185db-loop[\"currentElement\"][\"nodeText\"] }}",
              "details": "{{ 735b7a8e-6da5-4a2d-b5f6-dd34943993c4[\"result\"] }}",
              "timeout": "P3D",
              "onTimeout": "reject"
            }
          },
          {
            "name": "30de9f7c-b0b4-4806-8998-9b233e2469cc",
            "valid": false,
            "displayName": "Mark the draft created to prevent repeats",
            "type": "PIECE",
            "settings": {
              "pieceName": "@taskade/automade-internalpiece-taskade",
              "pieceVersion": "1.0.0",
              "actionName": "updateCustomFields",
              "input": {
                "fields": {
                  "@fudft": {
                    "data": {
                      "value": "{{ trigger[\"triggeredAt\"] }}"
                    },
                    "rank": "0",
                    "fieldId": "@fudft"
                  }
                },
                "nodeId": "{{ 614eb1d4-5e41-4b4f-b574-b3ed6e0185db-loop[\"currentElement\"][\"nodeId\"] }}",
                "projectId": {
                  "type": "flow-template-variable-input-type",
                  "id": "wiNSVTzkVhm6kmjK"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "variables": {
    "wiNSVTzkVhm6kmjK": {
      "id": "wiNSVTzkVhm6kmjK",
      "rank": "V",
      "type": "string",
      "format": "taskade-project-id"
    },
    "01M71KJN8H0SPRYYP4VG6T2YBC": {
      "id": "01M71KJN8H0SPRYYP4VG6T2YBC",
      "rank": "k",
      "type": "string",
      "format": "taskade-space-agent-id"
    }
  }
}